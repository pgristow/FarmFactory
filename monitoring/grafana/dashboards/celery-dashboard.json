{
  "dashboard": {
    "id": null,
    "uid": "celery-monitoring",
    "title": "Celery Task Monitoring",
    "tags": ["celery", "tasks", "imports"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "type": "graph",
        "title": "Active Tasks by Queue",
        "targets": [
          {
            "expr": "celery_tasks_active{queue=\"imports\"}",
            "legendFormat": "Imports Queue",
            "refId": "A"
          },
          {
            "expr": "celery_tasks_active{queue=\"default\"}",
            "legendFormat": "Default Queue",
            "refId": "B"
          },
          {
            "expr": "celery_tasks_active{queue=\"maintenance\"}",
            "legendFormat": "Maintenance Queue",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Active Tasks"
          },
          {
            "format": "short"
          }
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "id": 2,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "type": "graph",
        "title": "Task Success vs Failure Rate",
        "targets": [
          {
            "expr": "rate(celery_tasks_succeeded_total[5m])",
            "legendFormat": "Success Rate",
            "refId": "A"
          },
          {
            "expr": "rate(celery_tasks_failed_total[5m])",
            "legendFormat": "Failure Rate",
            "refId": "B"
          },
          {
            "expr": "rate(celery_tasks_retried_total[5m])",
            "legendFormat": "Retry Rate",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Tasks/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "type": "graph",
        "title": "Task Duration (95th Percentile)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(celery_task_duration_seconds_bucket[5m]))",
            "legendFormat": "{{task_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "type": "stat",
        "title": "Worker Status",
        "targets": [
          {
            "expr": "celery_workers_online",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "type": "table",
        "title": "Task Summary",
        "targets": [
          {
            "expr": "sum by (task_name, state) (celery_task_state)",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto"
            }
          }
        }
      }
    ]
  }
}
