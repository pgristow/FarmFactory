{
  "cost_breakdown_pie": {
    "type": "pie",
    "title": "Cost Breakdown by Category",
    "description": "Distribution of input costs across categories",
    "dataField": "cost_category",
    "valueField": "total_cost_usd",
    "colors": ["#4caf50", "#2196f3", "#ff9800", "#f44336", "#9c27b0", "#00bcd4"],
    "labels": {
      "seeds": "Seeds & Planting",
      "fertilizers": "Fertilizers",
      "pesticides": "Pesticides",
      "water": "Water & Irrigation",
      "labor": "Labor",
      "equipment": "Equipment & Maintenance",
      "other": "Other Costs"
    },
    "showPercentage": true,
    "showValues": true,
    "showLegend": true,
    "responsive": true
  },
  "revenue_over_time": {
    "type": "bar",
    "title": "Revenue Over Time",
    "description": "Harvest revenue by period",
    "xAxis": {
      "field": "period",
      "label": "Period",
      "format": "MMM YYYY"
    },
    "yAxis": {
      "field": "revenue_usd",
      "label": "Revenue",
      "unit": "$",
      "format": "0,0.00"
    },
    "colors": ["#4caf50"],
    "showValues": true,
    "aggregation": "sum",
    "groupBy": "month",
    "responsive": true
  },
  "profit_margin_trends": {
    "type": "line",
    "title": "Profit Margin Trends",
    "description": "Profit margin percentage over time",
    "xAxis": {
      "field": "period",
      "label": "Period",
      "format": "MMM YYYY"
    },
    "yAxis": {
      "field": "profit_margin_percent",
      "label": "Profit Margin",
      "unit": "%",
      "format": "0.0",
      "min": 0
    },
    "colors": ["#2196f3"],
    "targetBands": [
      {
        "min": 40,
        "max": 100,
        "color": "#c8e6c9",
        "label": "Target Range",
        "opacity": 0.3
      },
      {
        "min": 20,
        "max": 40,
        "color": "#fff9c4",
        "label": "Acceptable",
        "opacity": 0.2
      }
    ],
    "showMarkers": true,
    "showLegend": true,
    "responsive": true
  },
  "roi_by_crop_type": {
    "type": "bar",
    "title": "ROI by Crop Type",
    "description": "Return on investment for different crops",
    "xAxis": {
      "field": "crop_name",
      "label": "Crop Type"
    },
    "yAxis": {
      "field": "roi_percent",
      "label": "ROI",
      "unit": "%",
      "format": "0.0"
    },
    "colors": ["#ff9800"],
    "showValues": true,
    "horizontal": false,
    "sortBy": "value",
    "sortOrder": "desc",
    "responsive": true
  },
  "revenue_vs_costs_comparison": {
    "type": "grouped_bar",
    "title": "Revenue vs Costs by Plot",
    "description": "Compare revenue and costs across plots",
    "xAxis": {
      "field": "plot_name",
      "label": "Plot"
    },
    "yAxis": {
      "field": "amount_usd",
      "label": "Amount",
      "unit": "$",
      "format": "0,0"
    },
    "series": [
      {
        "field": "total_revenue",
        "label": "Revenue",
        "color": "#4caf50"
      },
      {
        "field": "total_costs",
        "label": "Costs",
        "color": "#f44336"
      }
    ],
    "showLegend": true,
    "responsive": true
  },
  "cumulative_profit_loss": {
    "type": "area",
    "title": "Cumulative Profit/Loss",
    "description": "Cumulative profit or loss over time",
    "xAxis": {
      "field": "date",
      "label": "Date",
      "format": "MMM DD"
    },
    "yAxis": {
      "field": "cumulative_profit_usd",
      "label": "Cumulative Profit/Loss",
      "unit": "$",
      "format": "0,0"
    },
    "colors": ["#2196f3"],
    "fillOpacity": 0.3,
    "zeroLine": {
      "show": true,
      "color": "#9e9e9e",
      "width": 2
    },
    "areaColors": {
      "positive": "#4caf50",
      "negative": "#f44336"
    },
    "responsive": true
  },
  "cost_per_hectare_comparison": {
    "type": "bar",
    "title": "Cost per Hectare by Plot",
    "description": "Total costs normalized by plot area",
    "xAxis": {
      "field": "plot_name",
      "label": "Plot"
    },
    "yAxis": {
      "field": "cost_per_ha_usd",
      "label": "Cost per Hectare",
      "unit": "$/ha",
      "format": "0,0"
    },
    "colors": ["#f44336"],
    "showValues": true,
    "responsive": true
  },
  "yield_per_hectare": {
    "type": "bar",
    "title": "Yield per Hectare",
    "description": "Harvest quantity per hectare by plot",
    "xAxis": {
      "field": "plot_name",
      "label": "Plot"
    },
    "yAxis": {
      "field": "yield_per_ha_kg",
      "label": "Yield",
      "unit": "kg/ha",
      "format": "0,0"
    },
    "colors": ["#4caf50"],
    "showValues": true,
    "responsive": true
  },
  "financial_kpi_dashboard": {
    "type": "multi_metric_card",
    "title": "Financial KPIs",
    "description": "Key financial performance indicators",
    "metrics": [
      {
        "field": "total_revenue",
        "label": "Total Revenue",
        "unit": "$",
        "format": "0,0",
        "icon": "attach_money",
        "color": "#4caf50",
        "trend": true,
        "trendPeriod": "vs_last_period"
      },
      {
        "field": "total_costs",
        "label": "Total Costs",
        "unit": "$",
        "format": "0,0",
        "icon": "shopping_cart",
        "color": "#f44336",
        "trend": true,
        "trendPeriod": "vs_last_period"
      },
      {
        "field": "net_profit",
        "label": "Net Profit",
        "unit": "$",
        "format": "0,0",
        "icon": "trending_up",
        "color": "#2196f3",
        "trend": true,
        "trendPeriod": "vs_last_period"
      },
      {
        "field": "profit_margin",
        "label": "Profit Margin",
        "unit": "%",
        "format": "0.0",
        "icon": "percent",
        "color": "#ff9800",
        "trend": true,
        "trendPeriod": "vs_last_period"
      }
    ],
    "responsive": true
  },
  "cost_timeline_stacked": {
    "type": "stacked_area",
    "title": "Cost Timeline by Category",
    "description": "Breakdown of costs over time",
    "xAxis": {
      "field": "date",
      "label": "Date",
      "format": "MMM DD"
    },
    "yAxis": {
      "field": "cost_usd",
      "label": "Cost",
      "unit": "$",
      "format": "0,0"
    },
    "series": [
      {
        "field": "seeds_cost",
        "label": "Seeds",
        "color": "#8bc34a"
      },
      {
        "field": "fertilizer_cost",
        "label": "Fertilizers",
        "color": "#4caf50"
      },
      {
        "field": "pesticide_cost",
        "label": "Pesticides",
        "color": "#cddc39"
      },
      {
        "field": "water_cost",
        "label": "Water",
        "color": "#2196f3"
      },
      {
        "field": "labor_cost",
        "label": "Labor",
        "color": "#ff9800"
      },
      {
        "field": "equipment_cost",
        "label": "Equipment",
        "color": "#795548"
      }
    ],
    "aggregation": "sum",
    "groupBy": "week",
    "showLegend": true,
    "responsive": true
  },
  "profitability_by_season": {
    "type": "grouped_bar",
    "title": "Profitability by Season",
    "description": "Compare profitability across seasons",
    "xAxis": {
      "field": "season",
      "label": "Season"
    },
    "yAxis": {
      "field": "amount_usd",
      "label": "Amount",
      "unit": "$",
      "format": "0,0"
    },
    "series": [
      {
        "field": "revenue",
        "label": "Revenue",
        "color": "#4caf50"
      },
      {
        "field": "costs",
        "label": "Costs",
        "color": "#f44336"
      },
      {
        "field": "profit",
        "label": "Profit",
        "color": "#2196f3"
      }
    ],
    "showLegend": true,
    "responsive": true
  },
  "break_even_analysis": {
    "type": "dual_line",
    "title": "Break-Even Analysis",
    "description": "Revenue and costs with break-even point",
    "xAxis": {
      "field": "production_units",
      "label": "Production (units)",
      "format": "0,0"
    },
    "yAxis": {
      "field": "amount_usd",
      "label": "Amount",
      "unit": "$",
      "format": "0,0"
    },
    "series": [
      {
        "field": "total_revenue",
        "label": "Total Revenue",
        "color": "#4caf50"
      },
      {
        "field": "total_costs",
        "label": "Total Costs",
        "color": "#f44336"
      }
    ],
    "breakEvenPoint": {
      "show": true,
      "markerColor": "#ff9800",
      "label": "Break-Even Point"
    },
    "showLegend": true,
    "responsive": true
  }
}
