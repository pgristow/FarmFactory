# Application Settings
APP_NAME=FarmFactory
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://farm_user:farmpass@localhost:5432/farmfactory
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Update with your frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# Data Retention (days)
ENVIRONMENTAL_DATA_RETENTION_DAYS=365
IRRIGATION_DATA_RETENTION_DAYS=730
NUTRIENT_DATA_RETENTION_DAYS=730
WATER_QUALITY_DATA_RETENTION_DAYS=365
