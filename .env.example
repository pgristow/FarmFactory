# FarmFactory Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=farmfactory
POSTGRES_USER=farm_user
POSTGRES_PASSWORD=farmpass123
POSTGRES_PORT=5432

# Database URL (auto-constructed from above values in docker-compose)
# For local development outside Docker: postgresql://farm_user:farmpass123@localhost:5432/farmfactory
DATABASE_URL=postgresql://farm_user:farmpass123@postgres:5432/farmfactory

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=redispass123
REDIS_PORT=6379
REDIS_URL=redis://:redispass123@redis:6379/0

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
BACKEND_PORT=8000

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=dev-secret-key-change-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Add your frontend URLs
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# File Upload and Storage
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/app/uploads
FILE_RETENTION_DAYS=30

# Celery Worker Configuration
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_TASK_TIME_LIMIT=2400
CELERY_TASK_SOFT_TIME_LIMIT=1800

# Flower Monitoring (Celery UI)
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# Logging
LOG_LEVEL=INFO

# =============================================================================
# EMAIL CONFIGURATION (for alerts and notifications)
# =============================================================================
# SMTP Settings - Configure for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
ALERT_EMAIL_FROM=noreply@farmfactory.com
SMTP_USE_TLS=true

# Email Recipients
ADMIN_EMAIL=admin@farmfactory.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# Application Name
APP_NAME=FarmFactory

# Timezone
TZ=UTC

# =============================================================================
# MONITORING CONFIGURATION (for Prometheus/Grafana)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_PORT=3001

PROMETHEUS_PORT=9090

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Weather API
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# AWS S3 (if using for file storage instead of local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEATHER_INTEGRATION=false
ENABLE_IOT_SENSORS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache TTL (seconds)
CACHE_TTL=300

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Set to true to enable API documentation
ENABLE_DOCS=true

# Set to true to enable CORS in development
ENABLE_CORS=true

# =============================================================================
# PRODUCTION SETTINGS (uncomment and configure for production)
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# ENABLE_DOCS=false
# LOG_LEVEL=WARNING
# POSTGRES_PASSWORD=use-a-strong-password-here
# REDIS_PASSWORD=use-a-strong-password-here
# SECRET_KEY=use-openssl-rand-hex-32-to-generate-this
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# VITE_API_URL=https://api.yourdomain.com

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit the .env file to version control
# 2. Always use strong passwords in production
# 3. Generate SECRET_KEY using: openssl rand -hex 32
# 4. Update ALLOWED_ORIGINS with your actual frontend URL in production
# 5. Configure SMTP settings with real email service in production
# 6. Set DEBUG=false in production
# 7. Use environment-specific .env files (.env.production, .env.staging)
