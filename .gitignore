# ============================================================================
# Project Specific
# ============================================================================

# Uploads directory (user-uploaded files)
uploads/
backend/uploads/
/uploads/*
!/uploads/.gitkeep

# Logs
logs/
*.log
backend/logs/
frontend/logs/

# Temporary files
tmp/
temp/
*.tmp

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Keep example environment file
!.env.example

# CSV/Excel uploaded files (keep templates)
*.csv
*.xlsx
*.xls
!templates/**/*.csv
!templates/**/*.xlsx

# Generated documentation
docs/_build/
docs/.buildinfo

# Alembic migration testing
alembic/versions/test_*.py

# Test data
test_data/
test_uploads/

# Backup files
*.bak
*.backup
*.old

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# SSL certificates (never commit!)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Secrets and credentials (never commit!)
secrets/
credentials/
*.secret
*.credentials

# MinIO / S3 local storage
minio_data/
s3_data/

# Redis dump
dump.rdb
appendonly.aof

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Kubernetes
*.kubeconfig

# Monitoring and profiling
*.prof
*.trace

# Generated reports
reports/
*.pdf
*.report

# Cache directories
.cache/
*.cache

# ============================================================================
# Keep these files
# ============================================================================

# Keep empty directories with .gitkeep
!.gitkeep

# Keep important config files
!docker-compose.yml
!Dockerfile
!.dockerignore
!.env.example
